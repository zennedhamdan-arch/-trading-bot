# ============================================================================
# AI Trader — environment configuration
# Copy this file to `.env`, fill in your keys, and restart the bot.
# The dashboard shows exactly which of these are missing (Configuration page).
# ============================================================================

# ── Broker + market data (Alpaca is the PRIMARY source) ─────────────────────
# Alpaca paper-trading account → https://app.alpaca.markets (choose Paper)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market-data feed. The free/paper subscription only permits IEX; requesting
# SIP fails with "subscription does not permit querying recent SIP data".
# The feed is NEVER switched silently: a non-permitted feed fails honestly
# with DATA_UNAVAILABLE (SUBSCRIPTION_FEED_UNAVAILABLE).
ALPACA_DATA_FEED=IEX

# ── Real-time layer (Alpaca WebSockets; optional) ───────────────────────────
# Latest trades/quotes/minute bars + the news stream for the trade universe.
# Purely observational: ticks NEVER trigger LLM calls; the AI cycle stays on
# its scheduled interval. Requires Alpaca keys.
REALTIME_ENABLED=true
REALTIME_RECONNECT_SECONDS=30

# ── UNOROUTER (PRIMARY LLM provider; OpenAI-compatible gateway) ────────────
# https://unorouter.com — one key for 230+ models. The APPLICATION owns
# model selection and implements its own fallback chain; UnoRouter never
# chooses models for us. Model ids are verified against the live catalog at
# startup; an id that no longer exists is skipped with LLM_MODEL_UNAVAILABLE
# and the next configured model is tried.
# NOTE (catalog verified 2026-09-11): qwen3.8-flash-next:free is NOT in the
# current UnoRouter catalog — it is skipped at runtime and the chain
# continues to glm-5.3-flash:free. The closest valid free Qwen3.8 id is
# qwen3.8-27b:free.
UNOROUTER_ENABLED=true
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_PRIMARY_MODEL=glm-5.3-flash-thinking:free
UNOROUTER_FALLBACK_MODELS=qwen3.8-flash-next:free,glm-5.3-flash:free


# ── LLM provider credentials ────────────────────────────────────────────────
# Groq (free tier)     → https://console.groq.com   — technical/debate/risk/CIO
GROQ_ENABLED=true
GROQ_API_KEY=
# Google Gemini (free) → https://aistudio.google.com — news/fundamentals interpretation
GEMINI_API_KEY=
# OpenRouter (OPTIONAL — only used when OPENROUTER_MODEL is set + verified)
OPENROUTER_API_KEY=
# NVIDIA (OPTIONAL secondary provider, OpenAI-compatible NIM endpoint)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── LLM routing (provider per task; resolved at call time) ─────────────────
# Any task can point at any configured provider: groq | gemini | nvidia | openrouter
LLM_TECH_PROVIDER=unorouter
LLM_DEBATE_PROVIDER=unorouter
LLM_RISK_PROVIDER=unorouter
LLM_CIO_PROVIDER=unorouter
LLM_NEWS_PROVIDER=unorouter
LLM_FUNDAMENTALS_PROVIDER=unorouter

# ── LLM models (defaults verified against live catalogs, Sept 2026) ────────
# Groq shut down llama-3.1-8b-instant / llama-3.3-70b-versatile on 2026-08-16
# (Enterprise-only). Defaults below are Groq's recommended replacements and
# are re-verified against the live /models catalog at startup.
GROQ_TECH_MODEL=openai/gpt-oss-20b
GROQ_DEBATE_MODEL=openai/gpt-oss-20b
GROQ_RISK_MODEL=openai/gpt-oss-20b
GROQ_CIO_MODEL=openai/gpt-oss-120b
# Generic Groq model for chain fallback when a task has no specific one.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# OpenRouter: OPTIONAL. Only used when a model is EXPLICITLY configured and
# verified available for the account. Empty = not routed. (The old free
# risk model was withdrawn; leaving this empty routes risk to Groq.)
OPENROUTER_MODEL=
# NVIDIA model id (required if any task/fallback routes to NVIDIA)
NVIDIA_MODEL=
# Gemini model for news/fundamentals interpretation ("models/" prefix optional)
GEMINI_MODEL=gemini-3.6-flash

# ── Global LLM fallback route (optional, explicit, verified) ────────────────
# Used when a task's primary route fails with MODEL_NOT_FOUND / PROVIDER_ERROR /
# AUTH_ERROR / NETWORK_ERROR — never for quota errors, never silently. Both
# values must be set; the model is verified against the fallback provider's
# live catalog at startup.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# ── LLM quota protection (free-tier friendly) ───────────────────────────────
# Local rolling-24h request budgets per provider (0 disables). The Gemini
# free tier allows 20 requests/day on gemini-3.6-flash.
GEMINI_DAILY_REQUEST_LIMIT=20
GROQ_DAILY_REQUEST_LIMIT=0
OPENROUTER_DAILY_REQUEST_LIMIT=0
NVIDIA_DAILY_REQUEST_LIMIT=0
# Minutes to pause a provider after a quota-exhausted (429) error with no
# usable retry delay.
GEMINI_QUOTA_BACKOFF_MINUTES=60
GROQ_QUOTA_BACKOFF_MINUTES=10
OPENROUTER_QUOTA_BACKOFF_MINUTES=60
NVIDIA_QUOTA_BACKOFF_MINUTES=60
# Retries ONLY for transient rate limits (429 with a short explicit
# retry delay); quota exhaustion is never retried. Default 0 (V2 policy).
LLM_RATE_LIMIT_MAX_RETRIES=0
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=30

# Router-level response cache (identical prompt within the TTL is served
# from cache; the last cached response is the fallback-of-last-resort).
LLM_RESPONSE_CACHE_TTL_MINUTES=240
LLM_RESPONSE_CACHE_MAX_ENTRIES=500

# ── LLM latency / retries / model attempts (no long retries, ever) ─────────
# Hard per-request timeout for every LLM HTTP call.
LLM_REQUEST_TIMEOUT_SECONDS=10
# SDK-level retries (0 = the SDK never retries; the application's own
# model/provider fallback chain handles failures instead of waiting).
LLM_MAX_RETRIES=0
# Maximum model attempts per request across the fallback chain.
LLM_MAX_MODEL_ATTEMPTS=3

# ── LLM circuit breakers (classic CLOSED -> OPEN -> HALF_OPEN) ─────────────
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
LLM_CIRCUIT_BREAKER_BACKOFF_SECONDS=600
# (specific circuits: dead model / auth / quota)
MODEL_UNAVAILABLE_COOLDOWN_MINUTES=30
AUTH_COOLDOWN_MINUTES=60

# ── News Intelligence V2 ────────────────────────────────────────────────────
# Independent news worker: fetch -> normalize -> dedup -> relevance ->
# analyze (only NEW HIGH/MEDIUM articles) -> persistent intelligence.
# Trading cycles only READ the cache; they never wait on news or LLMs.
NEWS_ENABLED=true
NEWS_REFRESH_MINUTES=30
NEWS_CACHE_MAX_AGE_MINUTES=60
# Only articles at/above this relevance reach an LLM: HIGH | MEDIUM | LOW
NEWS_RELEVANCE_THRESHOLD=MEDIUM
NEWS_MAX_ARTICLES_PER_SYMBOL=20

# ── Agents ──────────────────────────────────────────────────────────────────
# CIO AI review runs ONLY on a valid setup that passed the hard risk engine.
CIO_AGENT_ENABLED=true
# Debate is OFF by default: it only runs on a high-confidence setup with
# conflicting evidence and a healthy provider. (ENABLE_DEBATE is the legacy name.)
DEBATE_AGENT_ENABLED=false
# Optional richer LLM interpretation of technicals (default off — the
# deterministic rule engine produces the setup verdict).
TECH_LLM_INTERPRETATION_ENABLED=false

# ── Deterministic risk engine (hard rules; LLM can never override) ─────────
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=0.80
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_TRADES_PER_DAY=10
# Event-risk behavior: reject | reduce | ignore
RISK_EVENT_RISK_ACTION=reduce
RISK_REQUIRE_MARKET_OPEN=true

# ── Safety ──────────────────────────────────────────────────────────────────
# This application is PAPER TRADING ONLY. There is no option to enable
# live-money trading; a non-paper ALPACA_BASE_URL is ignored.
PAPER_TRADING_ONLY=true

# ── LLM analysis reuse ──────────────────────────────────────────────────────
# Minutes an LLM analysis is reused while its exact input (headlines /
# fundamentals metrics) is unchanged — identical context is never re-sent.
NEWS_ANALYSIS_CACHE_TTL_MINUTES=240
FUNDAMENTALS_ANALYSIS_CACHE_TTL_MINUTES=480

# ── Fundamentals data providers ─────────────────────────────────────────────
# "none" (default): no fundamentals provider — the agent reports
# DATA_UNAVAILABLE and cycles continue on price/technical/news/risk evidence.
# Providers are pluggable (services/fundamentals_service.py): implement
# FundamentalsProvider with an OFFICIAL API and register it. No Yahoo
# scraping, no cookies/crumbs, no unofficial endpoints.
FUNDAMENTALS_PROVIDER=none
FUNDAMENTALS_FALLBACK_PROVIDER=
# Seconds a fundamentals result is cached per symbol within a cycle.
FUNDAMENTALS_RESULT_CACHE_TTL_SECONDS=60

# ── Bot behavior ────────────────────────────────────────────────────────────
TRADE_UNIVERSE=AAPL,MSFT,NVDA,TSLA,SPY
CYCLE_INTERVAL_MINUTES=15
MAX_POSITION_PCT=0.10

# ── Feature toggles ─────────────────────────────────────────────────────────
ENABLE_FUNDAMENTALS_AGENT=true
ENABLE_MEMORY=true
MEMORY_DB_PATH=data/memory.db
AGENT_ACCURACY_LOOKBACK=20

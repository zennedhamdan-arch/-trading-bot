# ============================================================================
# AI Trader — environment configuration
# Copy this file to `.env`, fill in your keys, and restart the bot.
# The dashboard shows exactly which of these are missing (Configuration page).
# ============================================================================

# ── Broker (REQUIRED for trading) ───────────────────────────────────────────
# Alpaca paper-trading account → https://app.alpaca.markets (choose Paper)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── LLM providers ───────────────────────────────────────────────────────────
# Groq (free tier)        → https://console.groq.com          — powers the
#                           Technical, Debate and CIO agents
GROQ_API_KEY=
# Google Gemini (free)    → https://aistudio.google.com        — powers the
#                           News and Fundamentals agents
GEMINI_API_KEY=
# Gemini model for the news/fundamentals agents (Interactions API).
# The "models/" prefix is optional and stripped if present.
GEMINI_MODEL=gemini-3.6-flash
# OpenRouter (free models)→ https://openrouter.ai              — powers the
#                           Risk agent
OPENROUTER_API_KEY=

# ── Bot behavior (defaults shown; all optional) ─────────────────────────────
# Comma-separated symbols analyzed every cycle
TRADE_UNIVERSE=AAPL,MSFT,NVDA,TSLA,SPY
# Autonomous cycle cadence, in minutes
CYCLE_INTERVAL_MINUTES=15
# Per-position concentration cap (0.10 = 10% of equity)
MAX_POSITION_PCT=0.10

# Optional pipeline stages
ENABLE_FUNDAMENTALS_AGENT=true
ENABLE_DEBATE=true
ENABLE_MEMORY=true
MEMORY_DB_PATH=data/memory.db
AGENT_ACCURACY_LOOKBACK=20

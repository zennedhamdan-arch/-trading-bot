# ============================================================================
# AI Trader — environment configuration
# Copy this file to `.env`, fill in your keys, and restart the bot.
# The dashboard shows exactly which of these are missing (Configuration page).
# ============================================================================

# ── Broker (REQUIRED for trading) ───────────────────────────────────────────
# Alpaca paper-trading account → https://app.alpaca.markets (choose Paper)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── LLM providers ───────────────────────────────────────────────────────────
# Groq (free tier)        → https://console.groq.com          — powers the
#                           Technical, Debate and CIO agents
GROQ_API_KEY=
# Google Gemini (free)    → https://aistudio.google.com        — powers the
#                           News and Fundamentals agents
GEMINI_API_KEY=
# OpenRouter (free models)→ https://openrouter.ai              — powers the
#                           Risk agent
OPENROUTER_API_KEY=

# ── LLM models (all configurable; defaults verified Sept 2026) ─────────────
# Groq shut down llama-3.1-8b-instant / llama-3.3-70b-versatile on 2026-08-16
# (Enterprise-only now). The defaults below are Groq's recommended
# replacements: https://console.groq.com/docs/deprecations
# Model ids are validated against each provider's LIVE /models catalog at
# startup — a bad id shows up as a dashboard warning and per-request
# MODEL_NOT_FOUND errors, never silent fake results.
GROQ_TECH_MODEL=openai/gpt-oss-20b
GROQ_DEBATE_MODEL=openai/gpt-oss-20b
GROQ_CIO_MODEL=openai/gpt-oss-120b
# OpenRouter: deepseek/deepseek-r1:free is no longer usable on the free
# variant; openai/gpt-oss-20b:free is verified free today. Free variants
# rotate — if the model disappears, the risk agent blocks trades with a
# clear MODEL_NOT_FOUND error instead of producing a fake verdict.
OPENROUTER_RISK_MODEL=openai/gpt-oss-20b:free
# Gemini model for the news/fundamentals agents (Interactions API).
# The "models/" prefix is optional and stripped if present.
GEMINI_MODEL=gemini-3.6-flash

# Optional EXPLICIT fallback models (empty = NO fallback, the default).
# A fallback is only used when it is configured AND verified in the
# provider's live model catalog at startup; never for quota errors (same
# provider = same quota), and never as a silent provider switch.
GROQ_TECH_FALLBACK_MODEL=
GROQ_DEBATE_FALLBACK_MODEL=
GROQ_CIO_FALLBACK_MODEL=
OPENROUTER_RISK_FALLBACK_MODEL=
GEMINI_FALLBACK_MODEL=

# ── LLM quota protection (free-tier friendly) ──────────────────────────────
# Local rolling-24h request budgets per provider. When reached, requests
# short-circuit with PROVIDER_QUOTA_EXCEEDED instead of hammering the
# provider. 0 disables the local cap. The Gemini free tier allows 20
# requests/day on gemini-3.6-flash, hence the default.
GEMINI_DAILY_REQUEST_LIMIT=20
GROQ_DAILY_REQUEST_LIMIT=0
OPENROUTER_DAILY_REQUEST_LIMIT=0
# Minutes to stop calling a provider after a server-side quota-exhausted
# (429) error that carries no usable retry delay.
GEMINI_QUOTA_BACKOFF_MINUTES=60
GROQ_QUOTA_BACKOFF_MINUTES=10
OPENROUTER_QUOTA_BACKOFF_MINUTES=60
# Retries ONLY for transient rate limits (429 with a short explicit retry
# delay); quota exhaustion is never retried.
LLM_RATE_LIMIT_MAX_RETRIES=1
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=30

# ── LLM analysis reuse (keeps cycles inside the daily quotas) ──────────────
# Minutes an LLM analysis is reused while its exact input (headlines /
# fundamentals metrics) is unchanged — identical context is never re-sent.
NEWS_ANALYSIS_CACHE_TTL_MINUTES=240
FUNDAMENTALS_ANALYSIS_CACHE_TTL_MINUTES=480

# ── Bot behavior (defaults shown; all optional) ─────────────────────────────
# Comma-separated symbols analyzed every cycle
TRADE_UNIVERSE=AAPL,MSFT,NVDA,TSLA,SPY
# Autonomous cycle cadence, in minutes
CYCLE_INTERVAL_MINUTES=15
# Per-position concentration cap (0.10 = 10% of equity)
MAX_POSITION_PCT=0.10

# ── Market data ─────────────────────────────────────────────────────────────
# Alpaca market-data feed. The free/paper subscription can only use IEX;
# requesting SIP fails with "subscription does not permit querying recent
# SIP data". Set to SIP only on a paid subscription.
ALPACA_DATA_FEED=IEX

# ── Fundamentals data layer (Yahoo rate-limit protection) ──────────────────
# Minutes a successful fundamentals fetch is cached per symbol.
FUNDAMENTALS_CACHE_TTL_MINUTES=60
# Minimum seconds between live yfinance calls.
FUNDAMENTALS_MIN_INTERVAL_SECONDS=2
# After an HTTP 429, back off from yfinance entirely for this many minutes.
FUNDAMENTALS_RATE_LIMIT_BACKOFF_MINUTES=10

# Optional pipeline stages
ENABLE_FUNDAMENTALS_AGENT=true
ENABLE_DEBATE=true
ENABLE_MEMORY=true
MEMORY_DB_PATH=data/memory.db
AGENT_ACCURACY_LOOKBACK=20
